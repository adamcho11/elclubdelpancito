generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  nombre      String
  telefono    String
  direccion   String?
  role        String       @default("user")
  submissions Submission[]
  weeklyPicks WeeklyPick[]
  createdAt   DateTime     @default(now())
}

model Submission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  plan      String
  notas     String?
  recibo    String?
  status    String   @default("pendiente")
  createdAt DateTime @default(now())
}

model WeeklyPick {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  complementId String
  weekStart    String
  createdAt    DateTime @default(now())

  @@unique([userId, weekStart])
}

model QrImage {
  id     Int    @id @default(autoincrement())
  imagen String
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  brand       String
  category    String
  description String
  shelfLife   String
  image       String
  price       Int
}

model Bread {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  ingredients String
  texture     String
  role        String
  image       String
}

model Plan {
  id                 Int     @id @default(autoincrement())
  slug               String  @unique
  name               String
  subtitle           String
  frequency          String
  breadComposition   String
  complements        String  // JSON array stored as string
  extraProduct       String
  target             String
  price              Int
  deliveriesPerMonth Int
  highlighted        Boolean @default(false)
}
